# Copy to src/taskflow/.env and fill in. That path is what docker-compose passes
# as env_file and what settings/base.py reads. The file is gitignored; this
# template is the committed record of every name the settings read.
#
# Values here are safe placeholders, not working credentials.

# --- Which settings module to load ----------------------------------------------
# Development, always, for local work. wsgi.py and asgi.py default to
# taskflow.settings.production when this is unset, so a real deploy must either
# set it explicitly or accept that default.
DJANGO_SETTINGS_MODULE=taskflow.settings.development


# --- Core -----------------------------------------------------------------------
# base.py ships a throwaway development default, so this is optional locally.
# production.py reads it with NO default and refuses to start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Keep it above 50 characters and do not prefix it with 'django-insecure-', or
# `check --deploy` will (correctly) flag it.
DJANGO_SECRET_KEY=

# Off unless explicitly enabled. development.py forces it True regardless.
DJANGO_DEBUG=False

# Comma-separated. Required by production.py; surrounding spaces are stripped.
# development.py uses ['*'] and ignores this.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# --- Database -------------------------------------------------------------------
# Parsed by env.db(). Required by production.py; base.py falls back to sqlite and
# development.py defaults to the compose Postgres service below.
DATABASE_URL=postgres://taskflow:taskflow@db:5432/taskflow


# --- Cache ----------------------------------------------------------------------
# Passed straight to the django_redis CACHES LOCATION.
REDIS_URL=redis://redis:6379/1


# --- Celery ---------------------------------------------------------------------
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
# 'django-db' stores results via django-celery-results.
CELERY_RESULT_BACKEND=django-db


# --- HTTPS (production only) ----------------------------------------------------
# All optional; the defaults in production.py are the secure ones. Override only
# when you have a reason -- e.g. HSTS on a domain that is not fully HTTPS yet.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# DJANGO_CONN_MAX_AGE=60


# --- CORS / CSRF (production only) ----------------------------------------------
# Comma-separated, scheme included. Explicit allowlist: CORS_ALLOW_ALL_ORIGINS is
# never set, because the JWT travels in a cookie and credentialed requests from
# arbitrary origins would carry it.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
